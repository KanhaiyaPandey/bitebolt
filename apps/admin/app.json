{
  "expo": {
    "name": "BiteBolt Admin",
    "slug": "bitebolt-admin",
    "owner": "kannhaiya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bitebolt-admin",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FA7938"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.bitebolt.admin",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FA7938"
      },
      "package": "in.bitebolt.admin",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BiteBolt Admin to access your photos to upload food images.",
          "cameraPermission": "Allow BiteBolt Admin to use your camera to take food photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb48db42-b157-4ab3-9f0e-58c2ef95cf74"
      }
    }
  }
}
