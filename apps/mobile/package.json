{
  "name": "@bitebolt/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --offline",
    "android": "expo start --android --offline",
    "ios": "expo start --ios --offline",
    "web": "expo start --web --offline",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "clean": "rm -rf .expo node_modules/.cache"
  },
  "dependencies": {
    "@bitebolt/types": "workspace:*",
    "@bitebolt/utils": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/urbanist": "^0.4.2",
    "@expo/metro-runtime": "~6.1.0",
    "@expo/vector-icons": "^14.0.0",
    "@hookform/resolvers": "^3.6.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@shopify/flash-list": "^2.1.0",
    "@tanstack/react-query": "^5.40.0",
    "axios": "^1.7.2",
    "expo": "~54.0.0",
    "expo-blur": "~15.0.0",
    "expo-constants": "~18.0.0",
    "expo-font": "~14.0.0",
    "expo-haptics": "~15.0.0",
    "expo-image": "~3.0.0",
    "expo-linear-gradient": "~15.0.0",
    "expo-linking": "~8.0.0",
    "expo-notifications": "~0.32.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-hook-form": "^7.51.5",
    "react-native": "0.81.4",
    "react-native-css-interop": "^0.2.1",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-skeleton-placeholder": "^5.2.4",
    "react-native-toast-message": "^2.3.3",
    "zod": "^3.23.6",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.6",
    "@bitebolt/eslint-config": "workspace:*",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.5.1",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "~19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "msw": "^2.14.6",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/[^/]+/node_modules/)?(?:(jest-)?react-native|@react-native(-community)?|@react-native(/.*)?|expo(nent)?|@expo(nent)?(/.*)?|@expo-google-fonts(/.*)?|react-navigation|@react-navigation(/.*)?|@unimodules(/.*)?|unimodules|sentry-expo|native-base|react-native-svg|nativewind|react-native-reanimated|react-native-safe-area-context|react-native-screens|react-native-toast-message|react-native-skeleton-placeholder|react-native-css-interop|@shopify(/.*)?|@bitebolt(/.*)?|@testing-library(/.*)?))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@bitebolt/types$": "<rootDir>/../../packages/types/src",
      "^@bitebolt/utils$": "<rootDir>/../../packages/utils/src"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ]
  }
}
