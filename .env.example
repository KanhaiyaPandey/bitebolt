# ─── DATABASE ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/bitebolt_db?schema=public"

# ─── REDIS ────────────────────────────────────────────────────────────────────
# In production, set REDIS_URL to a hosted Redis (e.g. Upstash) connection string —
# use "rediss://default:<password>@<host>:<port>" for TLS. When set, this overrides
# REDIS_HOST/PORT/PASSWORD below (see apps/api/src/app.module.ts CacheModule config).
REDIS_URL=""
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TTL=3600

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── TWILIO ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"
OTP_EXPIRY_MINUTES=10

# ─── RAZORPAY ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="bitebolt-media"
AWS_CLOUDFRONT_DOMAIN="https://cdn.bitebolt.in"

# ─── APP ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
# HOST must be "0.0.0.0" in production (e.g. on Render) to bind to all interfaces —
# "localhost" only works for local dev.
HOST="0.0.0.0"
PORT=3001
API_PREFIX="api/v1"
CORS_ORIGINS="http://localhost:3000,http://localhost:19006"
APP_NAME="BiteBolt"
SUPPORT_EMAIL="support@bitebolt.in"

# ─── THROTTLE / RATE LIMITING ────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── FCM (Firebase Cloud Messaging – for future push notifications) ───────────
FCM_SERVER_KEY=""
