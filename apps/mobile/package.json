{
  "name": "@bitebolt/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --offline",
    "android": "expo start --android --offline",
    "ios": "expo start --ios --offline",
    "web": "expo start --web --offline",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .expo node_modules/.cache"
  },
  "dependencies": {
    "@bitebolt/types": "workspace:*",
    "@bitebolt/utils": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
