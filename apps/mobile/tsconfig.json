{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "nativewind/types",
      "jest"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@bitebolt/types": [
        "../../packages/types/src"
      ],
      "@bitebolt/utils": [
        "../../packages/utils/src"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ]
}