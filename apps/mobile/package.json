    "react-native": "0.81.4",
    "react-native-css-interop": "^0.2.1",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-skeleton-placeholder": "^5.2.4",
    "react-native-toast-message": "^2.3.3",
    "zod": "^3.23.6",
    "zustand": "^4.5.2"
