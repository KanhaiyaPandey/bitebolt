    "@expo/metro-runtime": "~6.1.0",
    "@hookform/resolvers": "^3.6.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@shopify/flash-list": "^2.1.0",
    "@tanstack/react-query": "^5.40.0",
    "axios": "^1.7.2",
    "expo": "~54.0.0",
    "expo-blur": "~15.0.0",
    "expo-constants": "~18.0.0",
    "expo-font": "~14.0.0",
    "expo-haptics": "~15.0.0",
    "expo-image": "~3.0.0",
    "expo-linear-gradient": "~15.0.0",
